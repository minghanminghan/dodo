# Template: deploy/setup.sh fills in @NODE_BIN@ and installs it to /etc/systemd/system.
# Started by deploy/deploy.sh: backs up the DB, then migrates it with the new build at /opt/dodo/next.
[Unit]
Description=dodo pre-deploy DB backup and migration

[Service]
Type=oneshot
User=dodo
Group=dodo
WorkingDirectory=/opt/dodo/next
Environment=DODO_DB=/var/lib/dodo/dodo.db
Environment=DODO_FILES=/var/lib/dodo/files
Environment=DODO_BACKUPS=/var/backups/dodo
ExecStart=@NODE_BIN@ dist/backup.js --backup-only
ExecStart=@NODE_BIN@ dist/migrate.js
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dodo /var/backups/dodo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
